# MACVM core library load order (sprint_s06_detail.md "Load order").
# Name resolution happens at method-compile time: a file may only
# *reference* globals bound earlier (or in genesis).
01_object.mst
02_nil_boolean.mst
03_behavior.mst
04_transcript.mst
# BlockClosure isn't in the doc's numbered per-class list (a doc gap) but
# must load before any file that sends value/value: for real (05, 06).
04a_blockclosure.mst
05_magnitude.mst
06_smallinteger.mst
07_largeinteger.mst
08_double.mst
# 10 before 09: Character class>>initTable (09's doIt) needs Array>>at:put:
# already installed. See 10_array.mst's header comment.
10_array.mst
09_character.mst
11_bytearray.mst
12_string.mst
13_symbol.mst
14_association.mst
15_ordered.mst
16_dictionary.mst
17_interval.mst
18_writestream.mst
19_printing.mst
20_system.mst
# W1 "library wave 1" additions (WORLD.md's Layer-A/B staged-adoption plan):
# pure extensions of/additions to the classes above, so they load last and
# add nothing earlier files could depend on.
21_collections_ext.mst
22_set.mst
23_fraction.mst
# ScaledDecimal: Squeak's exact decimal with a display scale, backing the
# 3.14s2 literal (lexer/parser desugar it to numerator:denominator:scale:).
# A Fraction subclass — exact value, scale only governs printing.
23a_scaleddecimal.mst
24_readstream.mst
25_sortedcollection.mst
26_bag.mst
27_random.mst
28_point.mst
29_identity_collections.mst
30_date_time.mst
31_readwritestream.mst
32_object_protocol_gaps.mst
# G2 smappl: image-side Visual/Button/Glue widget layer (gui/smappl.md).
33_smappl.mst
# Phase W: reflection mirrors + outliner tools (docs/APPS.md).
34_tools.mst
# Canvas: RGBA pixel buffer (docs/CANVAS.md pixel path) + the Strongtalk 'fast
# floats' Mandelbrot demo that fills one.
36_pixmap.mst
35_mandelbrot.mst
# Canvas demo: libm function plot (sin/cos/exp) via the vector command path.
37_waves.mst
# SIMD vector value classes (docs/SIMD.md) — Float64x2/Float32x4 (+ NEON fuse).
38_simd.mst
# SIMD level 2 (docs/SIMD.md Part E) — FloatArray + explicit-NEON bulk kernels.
39_floatarray.mst
# SequenceableCollection search/copy protocol (Strongtalk port).
40_seqcltn_search.mst
# String splitting utilities (need OrderedCollection; Strongtalk port).
41_string_text.mst
# Richards + DeltaBlue workload classes (lifted from world/bench/) so the
# dashboard can chart the two classic OO benchmarks — loaded BEFORE the
# dashboard, whose benchRichards/benchDeltaBlue reference them by name (a
# bareword to an undefined class is a compile error, not a forward ref).
41a_bench_workloads.mst
# Benchmark dashboard: live cold/warm perf bar chart on the Canvas.
42_benchdash.mst
# GamePane: drive the native Metal game pane from Smalltalk (M3 slice,
# docs/gamepane_design.md). Numbered game primitives (id block 200+).
43_gamepane.mst
# SpriteDoc (docs/asset_editors_design.md): the sprite editor's pure document —
# frames of 4-bit pixels + one 16-entry palette, hex-row emit/parse, sheet-class
# source emit. World-list so games can file sheets in and the battery runs
# headless; the Cocoa face is 76_spriteed.mst (cocoaui list).
44a_spritedoc.mst
# SoundDoc (docs/asset_editors_design.md §3): the Sound Editor's pure document
# — the parametric Effect recipe (ADSR/oscillators/sweep/noise/echo/seed),
# clamps, THE flat params contract, 12 transcribed preset seeds,
# randomize/mutate, sheet-source emit. World-list for the same reason as
# SpriteDoc; the Cocoa face is 77_sounded.mst (cocoaui list).
44b_sounddoc.mst
# Breakout: a small but complete demo game exercising the whole engine
# (paddle/ball/brick physics, input, SFX, frame loop; docs/gamepane_design.md).
44_breakout.mst
# MandelZoom: a zooming Mandelbrot rendered live in the game pane (reuses
# Mandelbrot>>escapeAtRe:im:; progressive per-frame render, docs/gamepane_design.md).
45_mandelzoom.mst
# MandelVM: MandelZoom that dives once then stops — the standalone-window demo
# (macvm-gui mandelvm / run-mandelvm.sh) that quits when the demo ends.
46_mandelvm.mst
# Worker: primary/worker VM parallelism, copy-passing messages over MOP pickles
# (docs/multi-smalltalk-worker.md; prims 220-228). Harmless with no worker role.
47_worker.mst
# ParallelMandel: the worker capstone — the MandelZoom dive computed in
# parallel bands by N worker VMs, assembled + blitted by the primary (M4).
48_parallelmandel.mst
# Worms: a grid-based snake/light-cycle demo — you vs. two computer worms,
# grow by eating fruit, die on any edge or any worm's body (docs/gamepane_
# design.md, same GamePane engine as Breakout/MandelZoom).
48a_worms.mst
# Galaxigans: a Galaxian/Galaga fixed shooter for the native game pane
# (ported from the MACDART fork; uses the extended GamePane: text, multi-frame
# sprites, shader backdrops, per-scanline palette).
49_galaxigans.mst
# Cocoa bridge C0-C3: ObjcRef (retained id in a GC-opaque byte tail), the
# Cocoa facade, DNU dispatch, the main-thread hop + ObjcMainProxy
# (docs/cocoa_bridge_design.md; prims 230-242). Fails cleanly headless.
49_cocoa.mst
# CocoaString (docs/cocoa_bridge_design.md): a Smalltalk string that IS an
# NSString — size/indices/ranges in UTF-16 units, so any range it answers is
# valid for AppKit, and objcRef is the NSString itself (no marshalling at the
# boundary). String stays the byte vector; the two convert explicitly.
50_cocoastring.mst
# CocoaFile: whole-file slurp/spit as a UTF-8 String via NSString's own file
# methods (direct bridge send — thread-safe, works headless). The encoding-
# aware companion to PosixFile (world/61). Lettered slot, like 58a_base64.
49a_cocoafile.mst
# CocoaPad: the bridge capstone (C5) — a native NSWindow/field/button built
# in Smalltalk (onMain sends + Cocoa action:); Demos-menu launched.
50_cocoapad.mst
51_number_ext.mst
52_collection_ext.mst
53_string_stream_ext.mst
54_object_ext.mst
55_iteration_ext.mst
56_dict_point_set_ext.mst
57_format_iter_ext.mst
58_final_ext.mst
58a_base64.mst
59_reflection.mst
60_editor.mst
61_posix_io.mst
# Accelerate (vDSP/vForce) for bulk array math over the FFI — Accel facade
# (lazy dlopen) + NativeFloatArray (GC-stable mmap lanes, in-place ops,
# reductions, transcendentals). docs/accelerate_design.md.
61a_accelerate.mst
# FftScope: the FFT worked example — a live spectrum analyzer on the native
# game pane (two-tone signal synthesized by vector ops, split-complex FFT
# per frame, 128-bin magnitude bars; arrows steer the manual tone).
61b_fftscope.mst
# Granular sockets: the full BSD socket surface as first-class Smalltalk —
# UDP datagrams, arbitrary addresses, socket options, hand-crafted ICMP
# (docs/sockets_design.md). Zero new Rust, on world/61's Posix bindings.
61c_sockets.mst
# Ping: a real unprivileged ICMP ping built entirely in Smalltalk — the
# worked example for the sockets layer (checksum + packet crafted by hand).
61d_ping.mst
62_ioworker.mst
62a_iostreams.mst


# OTP-style supervision over the worker fleet (docs/otp_workers_design.md O0):
# WorkerSpec/WorkerSupervisor(#oneForOne)/WorkerNames/SupervisorRegistry.
74_supervisor.mst

# DNS name resolution over the async worker fleet: Posix getaddrinfo/inet_ntop
# bindings, Dns (the blocking addrinfo-chain walk), DnsService (a supervised
# #dns worker serving resolves by RPC, deadline-bounded). docs/dns_design.md.
75_dns.mst

# Exceptions (E0+E1, docs/exceptions_design.md): the hierarchy, signal, and
# BlockClosure>>on:do:. Purely additive — the VM does not signal yet (E4).
78_exceptions.mst
# Collection-tree completion (a respondsTo: census, filled at the right level
# of the hierarchy): Collection gains count:/anyOne/copyWith:/copyWithout:/
# asDictionary/remove:/removeAllSuchThat:, SequenceableCollection gains
# copyReplaceAll:with:/pairsDo:/atAllPut:/at:ifAbsent:/writeStream, and
# Dictionary finally gains removeKey: — the same no-tombstone heal Set uses.
79_collection_completion.mst
# Numeric/text completion: Number gains the sign predicates and the whole
# transcendental family (they lived on Double ONLY, so `1 sin` was a DNU),
# Integer gains bit/base protocol incl. an exact sqrtFloor, Double gains the
# IEEE special-value tests, String/Symbol/Character gain text protocol, and
# Object/UndefinedObject gain REAL ifNil: methods so reflective use works.
80_numeric_completion.mst
# Date today / Time now (docs: the census's most surprising hole — the wall
# clock existed, the calendar layer between it and Date/Time did not).
# Hinnant civil_from_days in pure Smalltalk; the UTC offset from localtime_r's
# tm_gmtoff, whose layout was probed on this machine, not assumed.
81_clock_completion.mst
# E4 (docs/exceptions_design.md): the VM's own failures become catchable
# signals. error: signals; unhandled runs primitive 95 unchanged, so a world
# with no on:do: behaves byte-identically. Also fixes the silent
# out-of-bounds: a bare <primitive:> with no fallback answered the RECEIVER.
82_vm_errors.mst
# String completion (the census gaps): text assembly (join:, splitOn:,
# format:, padLeftTo:/padRightTo:), searching (indexOf:startingAt:,
# occurrencesOfString:, beginsWith:), and UTF-8 awareness in place
# (utf8Size, codePointAt:, codePoints) so a byte-String can answer a text
# question without a Cocoa crossing.
83_string_completion.mst
# Object/stream completion: species (fixing `#sym , 'x'`), cycle-safe
# deepCopy, storeOn:/storeString, the missing type predicates, and
# ReadStream contents/skipTo:/collect: + WriteStream position/reset.
84_object_stream_completion.mst
