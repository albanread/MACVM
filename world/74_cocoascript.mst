"74_cocoascript.mst — CocoaScript: the Apple Event surface's world side.

 docs/applescript_design.md, stage 1b. macVM.app declares a scripting
 dictionary (Contents/Resources/macVM.sdef); this class is what answers it.

 How a script reaches here:

   osascript ──AE──▶ NSApp ──KVC──▶ MacvmAppDelegate (an #app-role ObjC class,
   src/runtime/objc_delegate.rs) ──▶ MacvmDelegate dispatchTicket:… ──▶ me.

 macOS resolves `application` properties by KVC against NSApp. NSApp does not
 implement them, so it asks its delegate `application:delegateHandlesKey:`;
 answering YES makes KVC send the delegate the accessor named for the key,
 which the #app role forwards here under the selector of the same name.

 Two representation rules, both from the design:

 * A text property crosses as a Smalltalk String — the delegate trampoline
   mints the NSString.
 * An ENUMERATED or BOOLEAN property crosses as an NSNumber, and an
   enumeration's value is its four-character CODE, not its name: `current
   view` answers 'MvV6' packed into an integer, and Script Editor decompiles
   that back to `canvas` through the dictionary. `viewCodes`/`themeCodes`
   below are that mapping, in both directions, in one place — and
   tools/check-sdef-parity.py fails the build if their ORDER drifts from the
   sdef's enumerators (a compiled script stores the code, so a reorder
   silently repoints every saved script).

 This class is deliberately not a shell: it answers exactly the keys in
 `scriptKeys` and nothing else."

Object subclass: CocoaScript [
    <classVars: Delegate Suspended NextEvalKey SweepTimer SweepTicks>

    "── the key set ──────────────────────────────────────────────────────
     The single list of properties we answer. `application:delegateHandlesKey:`
     consults it, so adding a property means adding its accessor here and its
     name here — no third place to forget."
    CocoaScript class >> scriptKeys [
        ^#('scriptCurrentView' 'scriptAppearance' 'scriptTranscript'
           'scriptWorkspaceText' 'scriptTranscriptCollapsed' 'scriptBusy'
           'scriptSelectedClass' 'scriptSelectedMethod' 'scriptSelectedPackage'
           'scriptDebuggerState')
    ]

    "Called by AppKit (through the #app role) for every `application` property
     a script touches — including Standard-Suite ones like `name` and
     `version`, which we must decline so AppKit answers them itself."
    CocoaScript class >> application: anApp delegateHandlesKey: aKey [
        | key |
        aKey isNil ifTrue: [ ^false ].
        key := aKey asString.
        ^self scriptKeys includes: key
    ]

    "── four-character codes ─────────────────────────────────────────────
     'MvV6' → 16r4D765636. Computed from the characters rather than written
     as a magic number, so the table reads the same as the sdef does."
    CocoaScript class >> fourCharCode: aString [
        | n |
        n := 0.
        aString do: [ :c | n := (n bitShift: 8) + c value ].
        ^n
    ]

    "The `view` enumeration, in the sdef's order — which is the LIVE
     registration order in CocoaUI class >> startup (workspace first, then
     each view class's own register)."
    CocoaScript class >> viewCodes [
        ^#(workspace browser browser2 find editor outliner canvas help debugger monitor)
    ]

    "The `appearance` enumeration — CocoaUI's own themeOrder."
    CocoaScript class >> themeCodes [ ^CocoaUI themeOrder ]

    "Symbol → its sdef code ('MvV0'..), by position. Answers nil for a symbol
     the sdef does not name (a view registered but never given a code — the
     honest answer is 'no code', never a wrong one)."
    CocoaScript class >> codeFor: aSymbol in: aList prefix: aPrefix [
        | i |
        i := 0.
        aList doWithIndex: [ :s :ix | s == aSymbol ifTrue: [ i := ix ] ].
        i = 0 ifTrue: [ ^nil ].
        ^self fourCharCode: aPrefix , (i - 1) printString
    ]

    "The inverse: an incoming code integer → its symbol, or nil."
    CocoaScript class >> symbolFor: aCode in: aList prefix: aPrefix [
        | found |
        found := nil.
        aList doWithIndex: [ :s :ix |
            (self fourCharCode: aPrefix , (ix - 1) printString) = aCode
                ifTrue: [ found := s ] ].
        ^found
    ]

    "An integer as an NSNumber ObjcRef — how an enumerated or boolean property
     travels over KVC. `numberWithInt:` is autoreleased (+0): AppKit reads it
     within this same run-loop turn, the same lifetime every other
     id-returning delegate callback relies on."
    CocoaScript class >> numberWith: anInteger [
        ^(Cocoa classNamed: 'NSNumber') numberWithInt: anInteger
    ]

    "── the properties ──────────────────────────────────────────────────"

    CocoaScript class >> scriptCurrentView [
        | code |
        code := self codeFor: CocoaUI activeView in: self viewCodes prefix: 'MvV'.
        code isNil ifTrue: [ ^nil ].
        ^self numberWith: code
    ]

    CocoaScript class >> setScriptCurrentView: aNumber [
        | sym |
        aNumber isNil ifTrue: [ ^self ].
        sym := self symbolFor: (aNumber sendI64: 'intValue')
                    in: self viewCodes prefix: 'MvV'.
        sym isNil ifTrue: [ ^self ].
        CocoaUI switchToView: sym
    ]

    CocoaScript class >> scriptAppearance [
        | code |
        code := self codeFor: CocoaUI theme in: self themeCodes prefix: 'MvA'.
        code isNil ifTrue: [ ^nil ].
        ^self numberWith: code
    ]

    CocoaScript class >> setScriptAppearance: aNumber [
        | sym |
        aNumber isNil ifTrue: [ ^self ].
        sym := self symbolFor: (aNumber sendI64: 'intValue')
                    in: self themeCodes prefix: 'MvA'.
        sym isNil ifTrue: [ ^self ].
        CocoaUI applyTheme: sym.
        CocoaUI saveTheme
    ]

    "Read-only: the log itself, newest line first. `clear transcript` is a
     separate verb rather than a settable property (design §3)."
    CocoaScript class >> scriptTranscript [ ^CocoaUI transcriptText ]

    CocoaScript class >> scriptWorkspaceText [ ^CocoaUI workspaceText ]

    CocoaScript class >> setScriptWorkspaceText: aString [
        aString isNil ifTrue: [ ^self ].
        CocoaUI setWorkspaceText: aString asString
    ]

    CocoaScript class >> scriptTranscriptCollapsed [
        ^self numberWith: (CocoaUI transcriptCollapsed ifTrue: [ 1 ] ifFalse: [ 0 ])
    ]

    CocoaScript class >> setScriptTranscriptCollapsed: aNumber [
        | want |
        aNumber isNil ifTrue: [ ^self ].
        want := (aNumber sendI64: 'intValue') ~= 0.
        want = CocoaUI transcriptCollapsed ifFalse: [ CocoaUI toggleTranscript ]
    ]

    "Read-only: is the primary VM working? Outstanding replies is the honest
     signal available today — it covers a scripted `evaluate` (stage 3) as
     well as any other in-flight request. It is not a lie in either
     direction: nothing is pending exactly when nothing was sent."
    CocoaScript class >> scriptBusy [
        ^self numberWith: (Worker pendingReplyCount > 0 ifTrue: [ 1 ] ifFalse: [ 0 ])
    ]

    "── what the browser is showing (read-only) ─────────────────────────
     A script could drive the browser but never confirm where it landed.
     Each answers a String, or empty when nothing is selected — never nil,
     because an AppleScript `text` property that vanishes reads as an error
     rather than as 'nothing selected'."
    CocoaScript class >> browserOr: aBlock [
        | b |
        b := Worker classNamed: #CocoaBrowser2.
        b isNil ifTrue: [ ^'' ].
        ^(aBlock value: b) ifNil: [ '' ]
    ]
    CocoaScript class >> scriptSelectedClass [
        ^self browserOr: [ :b | b selectedClassName ]
    ]
    CocoaScript class >> scriptSelectedMethod [
        ^self browserOr: [ :b | b selectedMethodName ]
    ]
    CocoaScript class >> scriptSelectedPackage [
        ^self browserOr: [ :b | b selectedPackageName ]
    ]

    "── the debugger (DBG4), scriptable ─────────────────────────────────
     Everything the Debugger tab's buttons do, driven by name. The halt
     itself is a PARKED loop on the primary: `debug` posts one command into
     it and answers the state, so a script steps by sending a command and
     reading the state back — exactly what the buttons do, minus the mouse."
    CocoaScript class >> scriptDebuggerState [
        "dbgReport answers an NSString ObjcRef; a `text` property must cross
         as a Smalltalk String, so decode it here rather than handing AppleScript
         a wrapper it cannot marshal."
        | r out |
        "NO `onMain`: a KVC accessor is ALREADY on the main thread (AppKit
         called us there), and hopping again from inside that callback fails
         with 'no main run loop?' — which AppleScript reports as a bare -10000.
         Every other accessor in this file is plain Smalltalk for the same
         reason."
        r := CocoaUI hostService send: 'dbgReport'.
        r isNil ifTrue: [ ^'RUNNING' ].
        out := r asString.
        r release.
        ^(out isNil or: [ out isEmpty ]) ifTrue: [ 'RUNNING' ] ifFalse: [ out ]
    ]

    CocoaScript class >> performDebugCommand: cmd [
        | line |
        line := cmd sendString: 'directParameter'.
        (line isNil or: [ line isEmpty ]) ifTrue: [
            ^self errorOn: cmd number: -1701
                   message: 'debug: say step, next, finish, continue, abort, frame N, or print <expr>' ].
        CocoaUI hostService send: 'dbgCommand:' with: (Cocoa nsString: line).
        "The halt loop republishes its report as it processes the command;
         answering the state here is what makes a script able to step and
         look, step and look."
        ^self scriptDebuggerState
    ]

    CocoaScript class >> performSetBreakpointCommand: cmd [
        ^self breakpointFor: cmd set: true
    ]
    CocoaScript class >> performClearBreakpointCommand: cmd [
        ^self breakpointFor: cmd set: false
    ]
    CocoaScript class >> breakpointFor: cmd set: setIt [
        | cls sel |
        cls := cmd sendString: 'directParameter'.
        sel := self argument: 'selector' of: cmd.
        (cls isNil or: [ cls isEmpty ]) ifTrue: [
            ^self errorOn: cmd number: -1701 message: 'breakpoint: no class name given' ].
        (sel isNil or: [ sel isEmpty ]) ifTrue: [
            ^self errorOn: cmd number: -1701 message: 'breakpoint: no selector given' ].
        setIt
            ifTrue: [ CocoaUI hostService
                        send: 'setBreakpointClass:selector:'
                        with: (Cocoa nsString: cls) with: (Cocoa nsString: sel) ]
            ifFalse: [ CocoaUI hostService
                        send: 'clearBreakpointClass:selector:'
                        with: (Cocoa nsString: cls) with: (Cocoa nsString: sel) ].
        ^(setIt ifTrue: [ 'break on ' ] ifFalse: [ 'cleared break on ' ]) , cls , '>>' , sel
    ]

    CocoaScript class >> sweepTicks [ ^SweepTicks isNil ifTrue: [ 0 ] ifFalse: [ SweepTicks ] ]

    "── the commands (design §3) ─────────────────────────────────────────
     Cocoa Scripting mints an NSScriptCommand per invocation and sends it
     performDefaultImplementation; the Rust subclass hands the command here.
     Each handler reads its own parameters off the command and answers the
     verb's result — nil for the void verbs.

     Failure is reported the way a script expects: `errorOn:number:message:`
     sets the command's own script-error properties, which AppleScript raises
     at the call site. That covers every failure these three verbs can
     ANTICIPATE (an unknown class name, a missing path). An unexpected guest
     error inside a handler is a separate mechanism — design §6.3, the
     dispatch_callback message that is currently discarded — and until that
     lands such a failure unwinds through the callback door and answers nil,
     i.e. the verb silently does nothing. Anticipated failures below are
     therefore checked explicitly rather than left to raise."

    "Set the script error AppleScript will raise at the caller. -10000 is
     errAEEventFailed, the general handler failure; the string is what the
     user sees."
    CocoaScript class >> errorOn: cmd number: n message: aString [
        cmd send: 'setScriptErrorNumber:' with: n.
        cmd send: 'setScriptErrorString:' with: (Cocoa nsString: aString).
        ^nil
    ]

    "A named argument off the command`s evaluatedArguments, as a Smalltalk
     String, or nil when the script omitted it."
    CocoaScript class >> argument: aName of: cmd [
        | args val |
        args := cmd send: 'evaluatedArguments'.
        args isNil ifTrue: [ ^nil ].
        val := args send: 'objectForKey:' with: (Cocoa nsString: aName).
        val isNil ifTrue: [ ^nil ].
        ^val asString
    ]

    "browse <class name> [selector <sel>] — show it in the Browser."
    CocoaScript class >> performBrowseCommand: cmd [
        | name sel browser |
        name := cmd sendString: 'directParameter'.
        (name isNil or: [ name isEmpty ])
            ifTrue: [ ^self errorOn: cmd number: -1701
                           message: 'browse: no class name given' ].
        (Worker classNamed: name asSymbol) isNil
            ifTrue: [ ^self errorOn: cmd number: -1728
                           message: 'browse: no class named ' , name ].
        "Browser V2 (V1 has no tab since the toolbar cleanup, so switching
         to #browser would leave the script looking at whatever was already
         on screen and silently report success)."
        browser := Worker classNamed: #CocoaBrowser2.
        browser isNil
            ifTrue: [ ^self errorOn: cmd number: -10000
                           message: 'browse: the browser is not loaded' ].
        CocoaUI switchToView: #browser2.
        browser revealClass: name.
        sel := self argument: 'selector' of: cmd.
        sel isNil ifFalse: [ browser selectMethod: sel ].
        ^nil
    ]

    "snapshot in <file> — write a PNG of the window."
    CocoaScript class >> performSnapshotCommand: cmd [
        | url path |
        url := (cmd send: 'evaluatedArguments')
                   ifNil: [ nil ]
                   ifNotNil: [ :a | a send: 'objectForKey:'
                                      with: (Cocoa nsString: 'file') ].
        url isNil
            ifTrue: [ ^self errorOn: cmd number: -1701
                           message: 'snapshot: no destination given' ].
        "An AppleScript `file`/`POSIX file` arrives as an NSURL; `path` is its
         POSIX form. A plain string would answer nil here, so fall back to
         reading the object itself as text."
        path := url sendString: 'path'.
        (path isNil or: [ path isEmpty ]) ifTrue: [ path := url asString ].
        (path isNil or: [ path isEmpty ])
            ifTrue: [ ^self errorOn: cmd number: -1701
                           message: 'snapshot: could not read the destination path' ].
        CocoaUI snapshotTo: path.
        ^nil
    ]

    "clear transcript — empty the log."
    CocoaScript class >> performClearTranscriptCommand: cmd [
        CocoaUI clearTranscript.
        ^nil
    ]

    "── world management (the World menu's verbs, scriptable) ────────────
     Each answers the host's own `OK <text>` payload as the command result,
     and turns an `ERR <why>` into a real script error the caller can catch
     with `try … on error` — the same contract the other verbs keep. No
     arming here: a script IS the deliberate act, and AppleScript already
     makes the caller name the verb."
    CocoaScript class >> worldReply: reply on: cmd what: aLabel [
        | br |
        br := Worker classNamed: #CocoaBrowser.
        (br isOk: reply) ifTrue: [ ^br payloadOf: reply ].
        self errorOn: cmd number: -2741 message: aLabel , ': ' , (br errorOf: reply).
        ^nil
    ]

    CocoaScript class >> performSaveSnapshotCommand: cmd [
        ^self worldReply: ((Worker classNamed: #CocoaBrowser) readReply:
                (CocoaUI hostService onMain snapshotWorldDefault))
              on: cmd what: 'save snapshot'
    ]

    CocoaScript class >> performRestoreSnapshotCommand: cmd [
        "`from` is optional — without it, the newest snapshot."
        | url path |
        "An AppleScript `file`/`POSIX file` arrives as an NSURL; `path` is its
         filesystem path (the snapshot verb's own rule, §performSnapshot)."
        url := (cmd send: 'evaluatedArguments')
                   ifNil: [ nil ]
                   ifNotNil: [ :a | a send: 'objectForKey:' with: (Cocoa nsString: 'from') ].
        path := url isNil
            ifTrue: [ CocoaUI latestSnapshotPath ]
            ifFalse: [ | p | p := (url send: 'path') asString.
                       (p isNil or: [ p isEmpty ]) ifTrue: [ url asString ] ifFalse: [ p ] ].
        path isNil ifTrue: [
            ^self errorOn: cmd number: -1728
                   message: 'restore snapshot: no snapshot saved yet' ].
        ^self worldReply: ((Worker classNamed: #CocoaBrowser) readReply:
                (CocoaUI hostService onMain restoreWorldFrom: path))
              on: cmd what: 'restore snapshot'
    ]

    CocoaScript class >> performCompactWorldCommand: cmd [
        ^self worldReply: ((Worker classNamed: #CocoaBrowser) readReply:
                (CocoaUI hostService onMain compactWorld))
              on: cmd what: 'compact world'
    ]

    CocoaScript class >> performRevertWorldCommand: cmd [
        ^self worldReply: ((Worker classNamed: #CocoaBrowser) readReply:
                (CocoaUI hostService onMain revertWorldToOriginal))
              on: cmd what: 'revert world'
    ]

    CocoaScript class >> performRevertLastCommand: cmd [
        ^self worldReply: ((Worker classNamed: #CocoaBrowser) readReply:
                (CocoaUI hostService onMain revertLastChange))
              on: cmd what: 'revert last change'
    ]

    "── evaluate: the asynchronous verb (design §5) ──────────────────────
     CocoaUI>>doIt posts to the primary VM and the reply lands later on the
     beat; the UI worker must not block. So `evaluate` cannot compute its
     answer inline — it SUSPENDS the Apple Event and resumes it when the
     reply arrives:

       performEvaluateCommand:  suspendExecution, remember the command, post
                                the doit, return nil — AppKit keeps pumping
       (reply arrives)          resume:with: sends resumeExecutionWithResult:
       (or the deadline passes) sweepDeadlines resumes with a script error

     Three details the design insists on, all here:

     * EXACTLY ONE resume. The reply and the deadline race, and resuming a
       command twice is not survivable — `resume:` drops the entry FIRST and
       does nothing if it is already gone.
     * The time limit must be OURS. If the primary never replies (it died, or
       the doit raised — serveUiDoit: sends no reply on a raise, by its own
       documented contract) nothing would ever resume the command and the
       script would hang until AppleScript`s own two-minute timeout produced
       a useless error. The ~4 Hz beat that already refreshes the toolbar
       metrics sweeps the deadline list instead. No NSTimer, no new machinery.
     * Resumption happens on the main thread — true by construction, since
       both the reply drain and the beat run there.

     Suspended is a Dictionary of id -> Array(command, deadlineMillis)."

    CocoaScript class >> defaultTimeLimitSeconds [ ^60 ]

    "The command`s `time limit` parameter in milliseconds, or the default."
    CocoaScript class >> deadlineFor: cmd [
        | secs |
        secs := self argument: 'timeLimit' of: cmd.
        secs := secs isNil
            ifTrue: [ self defaultTimeLimitSeconds ]
            ifFalse: [ secs asNumber ].
        (secs isNil or: [ secs <= 0 ]) ifTrue: [ secs := self defaultTimeLimitSeconds ].
        ^Time millisecondClockValue + (secs * 1000)
    ]

    CocoaScript class >> performEvaluateCommand: cmd [
        | src key |
        src := cmd sendString: 'directParameter'.
        (src isNil or: [ src isEmpty ])
            ifTrue: [ ^self errorOn: cmd number: -1701
                           message: 'evaluate: no source given' ].
        Suspended isNil ifTrue: [ Suspended := Dictionary new. NextEvalKey := 0 ].
        NextEvalKey := NextEvalKey + 1.
        key := NextEvalKey.
        "Suspend BEFORE posting, and inside this synchronous dispatch — it must
         precede the IMP`s return, or AppKit will treat the nil we answer as
         the command`s result."
        cmd send: 'suspendExecution'.
        Suspended at: key put: (Array with: cmd with: (self deadlineFor: cmd)).
        Worker uiRequest: #doitq args: (Array with: src)
               onReply: [ :result | self resume: key with: result ].
        ^nil
    ]

    "Syntax errors (design: a script sending unparseable source must get a
     SCRIPT ERROR, never the error text as a value). The VM parses inside
     prim_eval_doit and answers `parse error: ...` as the RESULT STRING, so
     the conversion happens on the reply path in `resume:with:` below — one
     round trip to the primary, then a proper script error.

     A pre-flight check here would save that round trip and keep a bad source
     out of the deadline table entirely, but it needs a PARSE-ONLY entry point
     the VM does not expose today (prim_eval_doit always parses AND runs).
     Adding one — `parse_top_items` behind its own primitive — is the honest
     follow-up; inventing a `Compiler checkSyntax:` that does not exist would
     just move the failure."

    "Resume a suspended command with its answer. One-shot: the entry is
     tombstoned first, so a later deadline sweep (or a duplicate reply) is a
     no-op rather than a second resume."
    CocoaScript class >> resume: key with: aString [
        | entry cmd text |
        Suspended isNil ifTrue: [ ^self ].
        entry := Suspended at: key ifAbsent: [ nil ].
        entry isNil ifTrue: [ ^self ].
        Suspended at: key put: nil.
        cmd := entry at: 1.
        "The primary answers a parse failure as the RESULT STRING
         'parse error: ...' (prim_eval_doit). A script must see that as an
         error, not as a value — matching the VM's own generated prefix, not
         guest data."
        text := aString isNil ifTrue: [ '' ] ifFalse: [ aString asString ].
        "serveUiDoit: replies `result printString`, so a String result arrives
         QUOTED — the marker is 'parse error:' with or without that leading
         quote. (Matching the VM's own generated prefix, never guest data.)"
        ((text startsWith: 'parse error:')
            or: [ (text startsWith: '''parse error:')
            or: [ text startsWith: 'error: ' ] ])
            ifTrue: [
                "Setting the error properties is not enough — a suspended
                 command must still be RESUMED for AppleScript to raise it."
                self errorOn: cmd number: -2741 message: 'evaluate: ' , text.
                ^self deferResume: cmd with: nil ].
        self deferResume: cmd with: (Cocoa nsString: aString asString)
    ]

    "Resume on a FRESH run-loop turn, never inline. resumeExecutionWithResult:
     pumps the Apple Event queue SYNCHRONOUSLY — a queued next event (scripts
     send them back-to-back) would be dispatched re-entrantly INTO the VM
     callback this resume is running in, nesting a doit inside a live
     interpreter frame — the forbidden reentrancy, and a measured SIGSEGV
     (far=0x100000000000, recovered by the C6 door, mis-blamed on whatever
     script command ran next). performSelector:afterDelay: fires with NO VM
     frame on the stack; AppKit retains the argument until then."
    CocoaScript class >> deferResume: cmd with: resultOrNil [
        cmd onMain performSelector: 'resumeExecutionWithResult:'
            withObject: resultOrNil afterDelay: 0.0
    ]

    "Resume with a script error instead of a value — the deadline path."
    CocoaScript class >> resumeError: key message: aString [
        | entry cmd |
        Suspended isNil ifTrue: [ ^self ].
        entry := Suspended at: key ifAbsent: [ nil ].
        entry isNil ifTrue: [ ^self ].
        Suspended at: key put: nil.
        cmd := entry at: 1.
        self errorOn: cmd number: -10000 message: aString.
        self deferResume: cmd with: nil
    ]

    "Called from the ~4 Hz beat (CocoaUI updateMetrics...). Resumes every
     command whose deadline has passed. Cheap and allocation-free when the
     table is empty, which is the normal case."
    CocoaScript class >> sweepDeadlines [
        | now expired |
        SweepTicks := (SweepTicks isNil ifTrue: [ 0 ] ifFalse: [ SweepTicks ]) + 1.
        Suspended isNil ifTrue: [ ^self ].
        now := Time millisecondClockValue.
        expired := nil.
        Suspended keysAndValuesDo: [ :k :v |
            v isNil ifFalse: [
                now >= (v at: 2) ifTrue: [
                    expired isNil ifTrue: [ expired := OrderedCollection new ].
                    expired add: k ] ] ].
        expired isNil ifTrue: [ ^self ].
        expired do: [ :k |
            self resumeError: k
                 message: 'evaluate: the image did not answer within the time limit' ]
    ]

    "── app-level delegate behaviour ─────────────────────────────────────
     Absorbed from the cocoa_gui-side delegate this role displaces: closing
     the last window quits the app, rather than leaving a headless process
     running (the on-screen 'close left the app running' report)."
    CocoaScript class >> applicationShouldTerminateAfterLastWindowClosed: anApp [
        ^true
    ]

    "── installation ────────────────────────────────────────────────────
     Mint the #app-role delegate bound to me and hand it to NSApp, REPLACING
     the minimal delegate cocoa_gui installed at startup (which answers the
     terminate question and nothing else, having no door into the world).
     Held in a class var for the process's life: AppKit does not retain a
     delegate, so dropping this reference would leave NSApp holding a dead
     pointer. Answers true when the app is now scriptable."
    CocoaScript class >> install [
        | app |
        Delegate isNil ifFalse: [ ^true ].
        app := Cocoa classNamed: 'NSApplication'.
        app isNil ifTrue: [ ^false ].
        Delegate := MacvmDelegate on: self role: #app.
        Delegate isNil ifTrue: [ ^false ].
        app sharedApplication onMain setDelegate: Delegate.
        "The deadline sweep must NOT share fate with the primary: the metrics
         beat that also sweeps is driven by the primary's own dispatch thread
         (supervisor.rs pumpInbox), so a busy or dead primary starves it —
         measured: `time limit 5` under a 500M-iteration doit never fired.
         A main-thread NSTimer ticks regardless. (The design's original 'no
         NSTimer, no new machinery' claim is thereby falsified and repealed;
         the metrics-beat sweep stays too — resumes are one-shot, so the two
         compose.) Scheduled on main: a timer attaches to the CURRENT
         thread's run loop, and only main's is pumped."
        SweepTimer isNil ifTrue: [
            "Driven by an NSTimer on MAIN, targeting the app delegate we
             just installed — NOT a `Cocoa action:` block. That path is
             asynchronous (macvm_action_fire posts an envelope for the inbox
             drain), so a watchdog built on it stalls exactly when the thing
             it watches stalls; measured, its ticks stopped arriving during a
             runaway doit. The delegate dispatches synchronously and is
             already retained for the process's life, which also disposes of
             the target-lifetime problem a bare action had."
            SweepTimer := (Cocoa classNamed: 'NSTimer') onMain
                scheduledTimerWithTimeInterval: 1.0
                target: Delegate
                selector: 'macvmSweep:' userInfo: nil repeats: true ].
        ^true
    ]
]
