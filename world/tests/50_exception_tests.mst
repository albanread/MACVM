"50_exception_tests.mst — ExceptionTests (docs/exceptions_design.md E0+E1).

 Gates the mechanism, not the classes: matching, subclass matching, the
 no-signal path, nesting, re-signalling from inside a handler, ensure:
 ordering, and — the one most likely to rot silently — that the handler
 stack is left EMPTY on every exit path."

TestCase subclass: ExceptionTests [
    runAll [
        self runTest: #testCatchesAndAnswersHandlerValue
             do: [ self testCatchesAndAnswersHandlerValue ].
        self runTest: #testNoSignalAnswersProtectedValue
             do: [ self testNoSignalAnswersProtectedValue ].
        self runTest: #testSubclassMatches do: [ self testSubclassMatches ].
        self runTest: #testNonMatchingInnerPassesOutward
             do: [ self testNonMatchingInnerPassesOutward ].
        self runTest: #testHandlerMayResignalOutward
             do: [ self testHandlerMayResignalOutward ].
        self runTest: #testEnsureRunsAfterHandler
             do: [ self testEnsureRunsAfterHandler ].
        self runTest: #testHandlerStackNeverLeaks
             do: [ self testHandlerStackNeverLeaks ].
        self runTest: #testMessageTextAndReport
             do: [ self testMessageTextAndReport ].
    ]

    testCatchesAndAnswersHandlerValue [
        self assert: ([ Error signal: 'boom' ] on: Error do: [ :e | e messageText ])
                     = 'boom'
    ]

    testNoSignalAnswersProtectedValue [
        self assert: ([ 42 ] on: Error do: [ :e | 0 ]) = 42
    ]

    "A handler for Error must catch a ZeroDivide — the search is by kind."
    testSubclassMatches [
        self assert: ([ ZeroDivide signal ] on: Error do: [ :e | e class name ])
                     = #ZeroDivide
    ]

    "An inner handler that does not match must not swallow the signal."
    testNonMatchingInnerPassesOutward [
        | r |
        r := [ [ Error signal: 'inner' ] on: ZeroDivide do: [ :e | 'wrong' ] ]
                on: Error do: [ :e | 'outer' ].
        self assert: r = 'outer'
    ]

    "A signal raised BY a handler must find the next handler outward, never
     re-enter itself (which would loop forever)."
    testHandlerMayResignalOutward [
        | r |
        r := [ [ Error signal: 'first' ]
                 on: Error do: [ :e | Error signal: 'second' ] ]
                on: Error do: [ :e | e messageText ].
        self assert: r = 'second'
    ]

    "ANSI ordering: the handler runs while the signalling stack is still
     live, and the ensure: blocks between run when the handler RETURNS. So
     the order is body, handler, ensure — not body, ensure, handler."
    testEnsureRunsAfterHandler [
        | log |
        log := OrderedCollection new.
        [ [ log add: #body. Error signal: 'x' ]
            ensure: [ log add: #ensure ] ]
          on: Error do: [ :e | log add: #handler ].
        self assert: log size = 3.
        self assert: (log at: 1) == #body.
        self assert: (log at: 2) == #handler.
        self assert: (log at: 3) == #ensure
    ]

    "Every exit path must pop: normal return, handled signal, and a signal
     that unwinds past an inner on:do:."
    testHandlerStackNeverLeaks [
        | before |
        before := Exception handlers size.
        [ 1 ] on: Error do: [ :e | 0 ].
        self assert: Exception handlers size = before.
        [ Error signal: 'a' ] on: Error do: [ :e | 0 ].
        self assert: Exception handlers size = before.
        [ [ Error signal: 'b' ] on: ZeroDivide do: [ :e | 0 ] ]
            on: Error do: [ :e | 0 ].
        self assert: Exception handlers size = before
    ]

    testMessageTextAndReport [
        | e |
        e := Error new.
        self assert: e report = 'An error occurred'.
        e messageText: 'specific'.
        self assert: e report = 'specific'.
        self assert: ZeroDivide new report = 'Division by zero'
    ]
]
