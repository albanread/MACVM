"76_spriteed.mst — the Sprite Editor window (docs/asset_editors_design.md).
 A utility window, summoned by Tools ▸ Sprite Editor…, that graphically edits
 the 16-colour hex-row sprites GamePane renders and saves them as sheet
 classes in the image. This file is only the Cocoa face; the document is
 SpriteDoc (world/44a_spritedoc.mst, world list, headless-tested) and the
 window computes nothing itself.

 Surfaces are NSImageViews fed by full RGBA base64 blasts through the canvas
 host verb (showCanvasPixelsOn:base64:width:height: — the CocoaCanvas path);
 mouse painting is a MacvmMouseView (an NSImageView subclass minted from
 the #mouseview delegate role) whose mouseDown:/mouseDragged: overrides
 dispatch straight into
 locationInView: (the reason that 1-arg holder exists). Blast, don't patch:
 every edit redraws the whole grid image from the model."
"A per-view mouse receiver: MacvmMouseView dispatches its overrides to ME
 through the C6 door, and I hand the NSEvent to a block. One holder per
 view, so two views on one editor never have to disambiguate."
Object subclass: CocoaMouseHandler [
    | Block |
    CocoaMouseHandler class >> on: aBlock [
        | h | h := self new. h setBlock: aBlock. ^h
    ]
    setBlock: aBlock [ Block := aBlock ]
    mouseDown: ev [ ^Block value: ev ]
    mouseDragged: ev [ ^Block value: ev ]
]

Object subclass: CocoaSpriteEditor [
    <classVars: Win WinDelegate Delegates StatusLabel
                Doc CurFrame SelColor Tool
                GridView SwatchView
                NameField WField HField
                RSlider GSlider BSlider RGBLabel
                FrameLabel ToolButtons EventLog
                PreviewOn PlayAnim Fps PlaySwitch FpsSlider FpsLabel
                DirtyTicks>

    CocoaSpriteEditor class >> windowWidth [ ^980.0 ]
    CocoaSpriteEditor class >> windowHeight [ ^560.0 ]
    CocoaSpriteEditor class >> gridBox [ ^432 ]
    CocoaSpriteEditor class >> gridLeft [ ^16.0 ]
    CocoaSpriteEditor class >> gridTop [ ^492.0 ]

    "── open / hide ──────────────────────────────────────────────────────"

    CocoaSpriteEditor class >> open [
        "Show the editor, building it on first use. Re-summoning an open
         editor just fronts it — state lives in class vars, so hiding (the
         red button) and reopening lose nothing."
        Win isNil ifTrue: [ self buildWindow ].
        Win isNil ifTrue: [ ^self ].
        Win onMain makeKeyAndOrderFront: nil.
        ^self
    ]

    CocoaSpriteEditor class >> windowShouldClose: sender [
        "The red button HIDES (MACDART's editors chose the same): doc,
         palette and tool state all survive to the next Tools-menu summon.
         Answer false so AppKit never actually closes."
        Win isNil ifFalse: [ Win onMain orderOut: nil ].
        ^false
    ]

    "── construction ─────────────────────────────────────────────────────"

    CocoaSpriteEditor class >> buildWindow [
        | winClass content |
        Delegates := OrderedCollection new.
        Doc := SpriteDoc new.
        CurFrame := 0. SelColor := 15. Tool := #pencil.
        PreviewOn := false. PlayAnim := true. Fps := 30. DirtyTicks := 0.
        winClass := Cocoa classNamed: 'NSWindow'.
        "styleMask 7 = titled|closable|miniaturizable: the layout is fixed
         (design §4), so no resizable bit."
        Win := ((winClass onMain alloc) onMain
            initWithContentRect: (Array with: 320.0 with: 200.0
                                        with: self windowWidth with: self windowHeight)
            styleMask: 7 backing: 2 defer: false).
        Win onMain setReleasedWhenClosed: false.
        Win onMain setTitle: 'Sprite Editor'.
        WinDelegate := MacvmDelegate windowDelegateOn: self.
        Win onMain setDelegate: WinDelegate.
        content := Win onMain contentView.
        content onMain setAutoresizesSubviews: true.
        self buildStatusIn: content.
        self buildGridIn: content.
        self buildToolsRowIn: content.
        self buildNameRowIn: content.
        self buildSwatchesIn: content.
        self buildSlidersIn: content.
        self buildFrameRowIn: content.
        self buildPreviewRowIn: content.
        self repaintAll.
        self setStatus: 'new 16x16 sprite — pencil paints colour 15; . is transparent'.
    ]

    CocoaSpriteEditor class >> buildStatusIn: content [
        StatusLabel := self label: '' frame: (Array with: 16.0 with: 4.0
                                                    with: self windowWidth - 32.0 with: 16.0)
                            in: content.
        StatusLabel onMain setTextColor:
            (Cocoa classNamed: 'NSColor') onMain secondaryLabelColor.
    ]

    "── small control factories (the CocoaCanvas idiom) ──────────────────"

    CocoaSpriteEditor class >> label: aString frame: rect in: parent [
        | l |
        l := ((Cocoa classNamed: 'NSTextField') onMain alloc) onMain
            initWithFrame: rect.
        l onMain setEditable: false. l onMain setBordered: false.
        l onMain setDrawsBackground: false. l onMain setSelectable: false.
        l onMain setFont: ((Cocoa classNamed: 'NSFont') onMain systemFontOfSize: 11.0).
        l onMain setStringValue: aString.
        parent onMain addSubview: l.
        ^l
    ]

    CocoaSpriteEditor class >> button: title frame: rect action: aBlock in: parent [
        | btn holder delegate |
        btn := ((Cocoa classNamed: 'NSButton') onMain alloc) onMain initWithFrame: rect.
        btn onMain setTitle: title.
        btn onMain setBezelStyle: 1.
        holder := CocoaToolbarAction on: aBlock.
        delegate := MacvmDelegate actionTargetOn: holder.
        btn onMain setTarget: delegate.
        btn onMain setAction: 'macvmAction:'.
        Delegates add: delegate.
        parent onMain addSubview: btn.
        ^btn
    ]

    CocoaSpriteEditor class >> field: aString frame: rect in: parent [
        | f |
        f := ((Cocoa classNamed: 'NSTextField') onMain alloc) onMain
            initWithFrame: rect.
        f onMain setStringValue: aString.
        parent onMain addSubview: f.
        ^f
    ]

    "A mouse-view whose down/drag events run aBlock with the NSEvent.
     Replaces the gesture-recognizer wiring wholesale: recognizers minted
     from the world never fired (real or synthetic events, valid SEL and
     retained target — cause unestablished), and view-level overrides are
     unconditional. The handler holder rides the SAME ticket registry as
     every delegate receiver, so it is GC-rooted for the view's life."
    CocoaSpriteEditor class >> mouseViewFrame: rect handler: aBlock [
        | view |
        view := MacvmDelegate mouseViewOn: (CocoaMouseHandler on: aBlock).
        view onMain setFrame: rect.
        ^view
    ]

    "── the paint grid ───────────────────────────────────────────────────"

    CocoaSpriteEditor class >> cellSize [
        ^(self gridBox // (Doc width max: Doc height)) max: 1
    ]
    CocoaSpriteEditor class >> gridPixelWidth [ ^self cellSize * Doc width ]
    CocoaSpriteEditor class >> gridPixelHeight [ ^self cellSize * Doc height ]

    CocoaSpriteEditor class >> buildGridIn: content [
        GridView := self mouseViewFrame:
            (Array with: self gridLeft
                   with: self gridTop - self gridPixelHeight
                   with: self gridPixelWidth asFloat
                   with: self gridPixelHeight asFloat)
            handler: [ :ev | self gridMouse: ev ].
        "NSImageScaleNone: the blast is already at view size, pixel for pixel."
        GridView onMain setImageScaling: 2.
        content onMain addSubview: GridView.
    ]

    CocoaSpriteEditor class >> gridMouse: ev [
        "Down/drag -> cell -> tool. The event's location is in WINDOW base
         coords; convertPoint:fromView: nil brings it into the view, origin
         BOTTOM-left (unflipped NSView), so the sprite row is flipped."
        | pt x y |
        pt := self viewPoint: ev in: GridView.
        "asInteger FIRST: the point's coordinates are Floats and Float has
         no // — truncation before integer division is equivalent here."
        x := (pt at: 1) asInteger // self cellSize.
        y := Doc height - 1 - ((pt at: 2) asInteger // self cellSize).
        self logEvent: 'grid ' , x printString , ',' , y printString.
        self toolAtX: x y: y.
        self markDirty.
    ]

    CocoaSpriteEditor class >> viewPoint: ev in: aView [
        "NSEvent window point -> aView's local point (both as #(x y))."
        | wp |
        wp := ev send: 'locationInWindow' args: (Array new: 0) ret: #point.
        ^aView send: 'convertPoint:fromView:'
               args: (Array with: (wp at: 1) with: (wp at: 2) with: nil)
               ret: #point
    ]

    "A rolling log of recognizer fires — the instrument that settles WHICH
     recognizer delivered (or stayed silent) on a real mouse. Read it with
     spedEvents; the newest entry also lands on the status line."
    CocoaSpriteEditor class >> logEvent: aString [
        "Ring only — the status line belongs to the tools, not to a
         per-stroke event feed."
        EventLog isNil ifTrue: [ EventLog := OrderedCollection new ].
        EventLog add: aString.
        EventLog size > 24 ifTrue: [ EventLog removeFirst ].
    ]
    "Scripting probes: the status line, and the coalescing state — DirtyTicks
     counts down 2->0 on the ~0.3s timer, so reading it after a mutate-then-
     wait proves the timer fires (0) or died (still 2) without guessing."
    CocoaSpriteEditor class >> spedStatus [
        StatusLabel isNil ifTrue: [ ^'' ].
        ^StatusLabel sendString: 'stringValue'
    ]
    CocoaSpriteEditor class >> spedDirty [ ^(DirtyTicks ifNil: [ -1 ]) printString ]
    CocoaSpriteEditor class >> addFrameForScript [ ^Doc addFrame ]

    CocoaSpriteEditor class >> spedEvents [
        | out |
        EventLog isNil ifTrue: [ ^'(no events)' ].
        out := WriteStream on: String new.
        EventLog do: [ :e | out nextPutAll: e; nextPutAll: ' | ' ].
        ^out contents
    ]

    CocoaSpriteEditor class >> toolAtX: x y: y [
        "Apply the current tool at sprite cell (x, y) — the ONE path both
         gestures and the scripting hooks go through."
        (x < 0 or: [ x >= Doc width or: [ y < 0 or: [ y >= Doc height ] ] ])
            ifTrue: [ ^self ].
        Tool = #pick ifTrue: [
            self selectColor: (Doc getPx: CurFrame x: x y: y).
            ^self ].
        Tool = #fill
            ifTrue: [
                (Doc floodFill: CurFrame x: x y: y color: SelColor)
                    ifTrue: [ self repaintGrid ] ]
            ifFalse: [
                (Doc setPx: CurFrame x: x y: y color: SelColor)
                    ifTrue: [ self repaintGrid ] ].
    ]

    CocoaSpriteEditor class >> repaintGrid [
        "The whole grid as one RGBA blast: cell colours from the palette,
         checkerboard for transparent (index 0), a 1px dark gridline lattice.
         Row 0 of the buffer is the TOP row on screen."
        | cell gw gh bytes rowbase idx sx sy c r g b checker |
        cell := self cellSize.
        gw := self gridPixelWidth. gh := self gridPixelHeight.
        bytes := ByteArray new: gw * gh * 4.
        0 to: gh - 1 do: [ :py |
            sy := py // cell.
            rowbase := py * gw * 4.
            0 to: gw - 1 do: [ :px |
                sx := px // cell.
                idx := Doc getPx: CurFrame x: sx y: sy.
                (px \\ cell = 0 or: [ py \\ cell = 0 ])
                    ifTrue: [ r := 40. g := 40. b := 44 ]
                    ifFalse: [
                        idx = 0
                            ifTrue: [
                                checker := ((px // 8) + (py // 8)) \\ 2.
                                checker = 0
                                    ifTrue: [ r := 58. g := 58. b := 64 ]
                                    ifFalse: [ r := 74. g := 74. b := 82 ] ]
                            ifFalse: [
                                c := Doc paletteAt: idx.
                                r := c at: 1. g := c at: 2. b := c at: 3 ] ].
                bytes at: rowbase + (px * 4) + 1 put: r.
                bytes at: rowbase + (px * 4) + 2 put: g.
                bytes at: rowbase + (px * 4) + 3 put: b.
                bytes at: rowbase + (px * 4) + 4 put: 255 ] ].
        GridView onMain setFrameSize:
            (Array with: gw asFloat with: gh asFloat).
        GridView onMain setFrameOrigin:
            (Array with: self gridLeft with: self gridTop - gh).
        CocoaBrowser hostService onMain
            showCanvasPixelsOn: GridView base64: (Base64 encode: bytes)
            width: gw printString height: gh printString.
    ]

    "── swatches (the palette strip: 8x2 cells of 48px, click to select) ──"

    CocoaSpriteEditor class >> swatchCell [ ^48 ]
    CocoaSpriteEditor class >> swatchLeft [ ^472.0 ]
    CocoaSpriteEditor class >> swatchBottom [ ^330.0 ]

    CocoaSpriteEditor class >> buildSwatchesIn: content [
        SwatchView := self mouseViewFrame:
            (Array with: self swatchLeft with: self swatchBottom
                   with: (self swatchCell * 8) asFloat
                   with: (self swatchCell * 2) asFloat)
            handler: [ :ev | self swatchMouse: ev ].
        SwatchView onMain setImageScaling: 2.
        content onMain addSubview: SwatchView.
    ]

    CocoaSpriteEditor class >> swatchMouse: ev [
        | pt col row |
        pt := self viewPoint: ev in: SwatchView.
        col := (pt at: 1) asInteger // self swatchCell.
        row := 1 - ((pt at: 2) asInteger // self swatchCell).
        self logEvent: 'swatch ' , col printString , ',' , row printString.
        (col between: 0 and: 7) ifFalse: [ ^self ].
        (row between: 0 and: 1) ifFalse: [ ^self ].
        self selectColor: (row * 8) + col.
    ]

    CocoaSpriteEditor class >> selectColor: i [
        SelColor := (i max: 0) min: 15.
        self repaintSwatches.
        self syncSliders.
        self setStatus: 'colour ' , SelColor printString ,
            (SelColor = 0 ifTrue: [ ' (transparent)' ] ifFalse: [ '' ]).
    ]

    CocoaSpriteEditor class >> repaintSwatches [
        "8x2 palette cells; the selected one wears a 3px white inner ring.
         Entry 0 is drawn over a checker, its round-trip colour in a centre
         square — honest about 'kept but transparent'."
        | cellPx sw sh bytes row col i c r g b border inCentre checker |
        cellPx := self swatchCell.
        sw := cellPx * 8. sh := cellPx * 2.
        bytes := ByteArray new: sw * sh * 4.
        0 to: sh - 1 do: [ :py |
            row := py // cellPx.
            0 to: sw - 1 do: [ :px |
                col := px // cellPx.
                i := (row * 8) + col.
                c := Doc paletteAt: i.
                r := c at: 1. g := c at: 2. b := c at: 3.
                i = 0 ifTrue: [
                    inCentre := ((px \\ cellPx) between: 14 and: 33)
                        and: [ (py \\ cellPx) between: 14 and: 33 ].
                    inCentre ifFalse: [
                        checker := (((px \\ cellPx) // 8) + ((py \\ cellPx) // 8)) \\ 2.
                        checker = 0
                            ifTrue: [ r := 58. g := 58. b := 64 ]
                            ifFalse: [ r := 74. g := 74. b := 82 ] ] ].
                border := (px \\ cellPx < 3 or: [ px \\ cellPx >= (cellPx - 3)
                    or: [ py \\ cellPx < 3 or: [ py \\ cellPx >= (cellPx - 3) ] ] ]).
                (border and: [ i = SelColor ]) ifTrue: [ r := 255. g := 255. b := 255 ].
                bytes at: (py * sw * 4) + (px * 4) + 1 put: r.
                bytes at: (py * sw * 4) + (px * 4) + 2 put: g.
                bytes at: (py * sw * 4) + (px * 4) + 3 put: b.
                bytes at: (py * sw * 4) + (px * 4) + 4 put: 255 ] ].
        CocoaBrowser hostService onMain
            showCanvasPixelsOn: SwatchView base64: (Base64 encode: bytes)
            width: sw printString height: sh printString.
    ]

    "── RGB sliders for the selected entry ───────────────────────────────"

    CocoaSpriteEditor class >> buildSlidersIn: content [
        RGBLabel := self label: '' frame: (Array with: 472.0 with: 300.0 with: 380.0 with: 16.0)
                         in: content.
        RSlider := self slider: (Array with: 472.0 with: 272.0 with: 320.0 with: 22.0) in: content.
        GSlider := self slider: (Array with: 472.0 with: 246.0 with: 320.0 with: 22.0) in: content.
        BSlider := self slider: (Array with: 472.0 with: 220.0 with: 320.0 with: 22.0) in: content.
        self syncSliders.
    ]

    CocoaSpriteEditor class >> slider: rect in: parent [
        | s holder delegate |
        s := ((Cocoa classNamed: 'NSSlider') onMain alloc) onMain initWithFrame: rect.
        s onMain setMinValue: 0.0.
        s onMain setMaxValue: 255.0.
        s onMain setContinuous: true.
        holder := CocoaToolbarAction on: [ self slidersChanged ].
        delegate := MacvmDelegate actionTargetOn: holder.
        s onMain setTarget: delegate.
        s onMain setAction: 'macvmAction:'.
        Delegates add: delegate.
        parent onMain addSubview: s.
        ^s
    ]

    CocoaSpriteEditor class >> slidersChanged [
        | r g b |
        r := (RSlider sendI64: 'integerValue').
        g := (GSlider sendI64: 'integerValue').
        b := (BSlider sendI64: 'integerValue').
        Doc setPal: SelColor r: r g: g b: b.
        self repaintSwatches.
        self repaintGrid.
        self syncRGBLabel.
        self markDirty.
    ]

    CocoaSpriteEditor class >> syncSliders [
        | c |
        RSlider isNil ifTrue: [ ^self ].
        c := Doc paletteAt: SelColor.
        RSlider onMain setIntegerValue: (c at: 1).
        GSlider onMain setIntegerValue: (c at: 2).
        BSlider onMain setIntegerValue: (c at: 3).
        self syncRGBLabel.
    ]

    CocoaSpriteEditor class >> syncRGBLabel [
        | c |
        RGBLabel isNil ifTrue: [ ^self ].
        c := Doc paletteAt: SelColor.
        RGBLabel onMain setStringValue: 'colour ' , SelColor printString ,
            '   R ' , (c at: 1) printString ,
            '  G ' , (c at: 2) printString ,
            '  B ' , (c at: 3) printString.
    ]

    "── name / size row ──────────────────────────────────────────────────"

    CocoaSpriteEditor class >> buildNameRowIn: content [
        self label: 'Name' frame: (Array with: 472.0 with: 502.0 with: 44.0 with: 16.0) in: content.
        NameField := self field: 'Sprite'
                          frame: (Array with: 518.0 with: 498.0 with: 170.0 with: 24.0) in: content.
        self label: 'W' frame: (Array with: 700.0 with: 502.0 with: 16.0 with: 16.0) in: content.
        WField := self field: '16'
                       frame: (Array with: 718.0 with: 498.0 with: 44.0 with: 24.0) in: content.
        self label: 'H' frame: (Array with: 770.0 with: 502.0 with: 16.0 with: 16.0) in: content.
        HField := self field: '16'
                       frame: (Array with: 788.0 with: 498.0 with: 44.0 with: 24.0) in: content.
        self button: 'Resize' frame: (Array with: 840.0 with: 496.0 with: 80.0 with: 28.0)
             action: [ self resizeClicked ] in: content.
    ]

    CocoaSpriteEditor class >> resizeClicked [
        | nw nh |
        nw := (WField sendString: 'stringValue') asInteger.
        nh := (HField sendString: 'stringValue') asInteger.
        (nw isNil or: [ nh isNil ]) ifTrue: [ ^self setStatus: 'resize: not a number' ].
        (Doc resizeTo: nw by: nh)
            ifTrue: [
                self markDirty.
                self repaintGrid.
                self setStatus: 'resized to ' , Doc width printString , 'x' , Doc height printString ]
            ifFalse: [ self setStatus: 'resize rejected (1..64, and different from now)' ].
    ]

    "── tools row (under the grid) ───────────────────────────────────────"

    CocoaSpriteEditor class >> buildToolsRowIn: content [
        ToolButtons := Dictionary new.
        ToolButtons at: #pencil put: (self button: '• Pencil'
            frame: (Array with: 16.0 with: 26.0 with: 84.0 with: 26.0)
            action: [ self selectTool: #pencil ] in: content).
        ToolButtons at: #fill put: (self button: 'Fill'
            frame: (Array with: 104.0 with: 26.0 with: 62.0 with: 26.0)
            action: [ self selectTool: #fill ] in: content).
        ToolButtons at: #pick put: (self button: 'Pick'
            frame: (Array with: 170.0 with: 26.0 with: 62.0 with: 26.0)
            action: [ self selectTool: #pick ] in: content).
        self button: '◀' frame: (Array with: 244.0 with: 26.0 with: 34.0 with: 26.0)
             action: [ self shiftBy: -1 dy: 0 ] in: content.
        self button: '▶' frame: (Array with: 280.0 with: 26.0 with: 34.0 with: 26.0)
             action: [ self shiftBy: 1 dy: 0 ] in: content.
        self button: '▲' frame: (Array with: 316.0 with: 26.0 with: 34.0 with: 26.0)
             action: [ self shiftBy: 0 dy: -1 ] in: content.
        self button: '▼' frame: (Array with: 352.0 with: 26.0 with: 34.0 with: 26.0)
             action: [ self shiftBy: 0 dy: 1 ] in: content.
        self button: 'Clear' frame: (Array with: 390.0 with: 26.0 with: 58.0 with: 26.0)
             action: [ self clearClicked ] in: content.
    ]

    CocoaSpriteEditor class >> selectTool: aSymbol [
        Tool := aSymbol.
        #(pencil fill pick) do: [ :t |
            (ToolButtons at: t ifAbsent: [ nil ]) ifNotNil: [ :btn |
                btn onMain setTitle:
                    ((t = aSymbol ifTrue: [ '• ' ] ifFalse: [ '' ]) ,
                     (t = #pencil ifTrue: [ 'Pencil' ]
                        ifFalse: [ t = #fill ifTrue: [ 'Fill' ] ifFalse: [ 'Pick' ] ])) ] ].
        self setStatus: 'tool: ' , aSymbol printString.
    ]

    CocoaSpriteEditor class >> shiftBy: dx dy: dy [
        Doc shift: CurFrame dx: dx dy: dy.
        self markDirty.
        self repaintGrid.
    ]

    CocoaSpriteEditor class >> clearClicked [
        Doc clearFrame: CurFrame.
        self repaintGrid.
        self markDirty.
        self setStatus: 'frame cleared'.
    ]

    "── frames row ───────────────────────────────────────────────────────"

    CocoaSpriteEditor class >> buildFrameRowIn: content [
        FrameLabel := self label: '' frame: (Array with: 472.0 with: 176.0 with: 96.0 with: 16.0)
                           in: content.
        self button: '|<' frame: (Array with: 570.0 with: 170.0 with: 40.0 with: 26.0)
             action: [ self gotoFrame: 0 ] in: content.
        self button: '<' frame: (Array with: 612.0 with: 170.0 with: 40.0 with: 26.0)
             action: [ self gotoFrame: CurFrame - 1 ] in: content.
        self button: '>' frame: (Array with: 654.0 with: 170.0 with: 40.0 with: 26.0)
             action: [ self gotoFrame: CurFrame + 1 ] in: content.
        self button: 'Add' frame: (Array with: 700.0 with: 170.0 with: 52.0 with: 26.0)
             action: [ self gotoFrame: Doc addFrame ] in: content.
        self button: 'Dup' frame: (Array with: 754.0 with: 170.0 with: 52.0 with: 26.0)
             action: [ self gotoFrame: (Doc dupFrame: CurFrame) ] in: content.
        self button: 'Del' frame: (Array with: 808.0 with: 170.0 with: 52.0 with: 26.0)
             action: [ self delFrameClicked ] in: content.
        self syncFrameLabel.
    ]

    CocoaSpriteEditor class >> gotoFrame: f [
        (f < 0 or: [ f >= Doc frameCount ]) ifTrue: [ ^self ].
        CurFrame := f.
        self syncFrameLabel.
        self repaintGrid.
        self markDirty.
    ]

    "── the engine preview (design §2: the real pane, driven the way demos
       are — a composed entry doit through launchDemo:, relaunched whole on
       every rebuild; the editor never edits engine state) ───────────────"

    CocoaSpriteEditor class >> buildPreviewRowIn: content [
        self button: 'Preview' frame: (Array with: 472.0 with: 132.0 with: 90.0 with: 26.0)
             action: [ self previewClicked ] in: content.
        PlaySwitch := ((Cocoa classNamed: 'NSButton') onMain alloc) onMain
            initWithFrame: (Array with: 570.0 with: 132.0 with: 64.0 with: 26.0).
        PlaySwitch onMain setButtonType: 3. "NSButtonTypeSwitch"
        PlaySwitch onMain setTitle: 'Play'.
        PlaySwitch onMain setState: 1.
        self wireControl: PlaySwitch to: [ self playToggled ].
        content onMain addSubview: PlaySwitch.
        FpsLabel := self label: 'fps 30' frame: (Array with: 648.0 with: 137.0 with: 56.0 with: 16.0)
                         in: content.
        FpsSlider := ((Cocoa classNamed: 'NSSlider') onMain alloc) onMain
            initWithFrame: (Array with: 708.0 with: 132.0 with: 152.0 with: 26.0).
        FpsSlider onMain setMinValue: 5.0.
        FpsSlider onMain setMaxValue: 60.0.
        FpsSlider onMain setDoubleValue: 30.0.
        self wireControl: FpsSlider to: [ self fpsChanged ].
        content onMain addSubview: FpsSlider.
    ]

    CocoaSpriteEditor class >> wireControl: aControl to: aBlock [
        | holder delegate |
        holder := CocoaToolbarAction on: aBlock.
        delegate := MacvmDelegate actionTargetOn: holder.
        aControl onMain setTarget: delegate.
        aControl onMain setAction: 'macvmAction:'.
        Delegates add: delegate.
    ]

    CocoaSpriteEditor class >> previewClicked [
        PreviewOn := true.
        self previewNow.
    ]
    CocoaSpriteEditor class >> playToggled [
        PlayAnim := (PlaySwitch sendI64: 'state') = 1.
        self markDirty.
    ]
    CocoaSpriteEditor class >> fpsChanged [
        Fps := ((FpsSlider send: 'doubleValue' args: (Array new: 0) ret: #f64)
                    max: 5) min: 60.
        Fps := Fps asInteger.
        FpsLabel onMain setStringValue: 'fps ' , Fps printString.
        self markDirty.
    ]

    "Every mutating edit calls this; CocoaUI's ~4Hz metrics beat calls
     previewTick (a world-targeted NSTimer never fires — the recognizers'
     fate again), so two quiet ticks equal roughly half a second of idle —
     MACDART's own coalescing cap, from a beat that already exists."
    CocoaSpriteEditor class >> markDirty [
        PreviewOn == true ifFalse: [ ^self ].
        DirtyTicks := 2.
    ]
    CocoaSpriteEditor class >> previewTick [
        "Called by CocoaUI's metrics beat whether or not the editor is open —
         every guard here is a nil guard first."
        (PreviewOn == true and: [ (DirtyTicks ifNil: [ 0 ]) > 0 ]) ifFalse: [ ^self ].
        DirtyTicks := DirtyTicks - 1.
        DirtyTicks = 0 ifTrue: [ self previewNow ].
    ]
    CocoaSpriteEditor class >> previewNow [
        | bc |
        bc := Worker classNamed: #CocoaBrowser.
        bc isNil ifTrue: [ ^self setStatus: 'preview: no host service' ].
        bc hostService onMain launchDemo: self previewDoit.
        self setStatus: 'preview launched (' , Doc frameCount printString ,
            (Doc frameCount = 1 ifTrue: [ ' frame, ' ] ifFalse: [ ' frames, ' ]) ,
            Fps printString , ' fps)'.
    ]

    CocoaSpriteEditor class >> previewDoit [
        "The whole preview scene as ONE entry doit for the primary: the real
         sprite at 1x plus 2x/4x renditions drawn with fill: rects (the
         engine has no sprite scale), animated by frame-switching in the
         step block. Regenerated from the model on every rebuild, so the
         preview cannot drift from the document."
        | out |
        out := WriteStream on: String new.
        out nextPutAll: '| p s fr tick last hex |'; nl.
        out nextPutAll: 'p := GamePane new.'; nl.
        out nextPutAll: 'p resizeTo: 320 by: 180.'; nl.
        out nextPutAll: 'p frameRate: '; nextPutAll: Fps printString; nextPutAll: '.'; nl.
        out nextPutAll: 'fr := Array'.
        0 to: Doc frameCount - 1 do: [ :f |
            out nextPutAll: (f = 0 ifTrue: [ ' with: ''' ] ifFalse: [ ' with: ''' ]);
                nextPutAll: (Doc rowsOf: f); nextPutAll: '''' ].
        out nextPutAll: '.'; nl.
        out nextPutAll: 's := p defineSprite: (fr at: 1).'; nl.
        out nextPutAll: '2 to: fr size do: [ :i | s addFrame: (fr at: i) ].'; nl.
        1 to: 15 do: [ :i |
            | c |
            c := Doc paletteAt: i.
            out nextPutAll: 's colorAt: '; nextPutAll: i printString;
                nextPutAll: ' r: '; nextPutAll: (c at: 1) printString;
                nextPutAll: ' g: '; nextPutAll: (c at: 2) printString;
                nextPutAll: ' b: '; nextPutAll: (c at: 3) printString; nextPutAll: '.'; nl.
            out nextPutAll: 'p paletteAt: '; nextPutAll: (16 + i) printString;
                nextPutAll: ' r: '; nextPutAll: (c at: 1) printString;
                nextPutAll: ' g: '; nextPutAll: (c at: 2) printString;
                nextPutAll: ' b: '; nextPutAll: (c at: 3) printString; nextPutAll: '.'; nl ].
        out nextPutAll: 'p paletteAt: 16 r: 68 g: 70 b: 84.'; nl.
        out nextPutAll: 'hex := ''0123456789abcdef''.'; nl.
        out nextPutAll: 'tick := 0. last := -1.'; nl.
        out nextPutAll: 'p onStep: [ | f rows y x c row |'; nl.
        out nextPutAll: '  tick := tick + 1.'; nl.
        out nextPutAll: (PlayAnim
            ifTrue: [ '  f := tick // 10 \ fr size.' ]
            ifFalse: [ '  f := ' , ((CurFrame min: Doc frameCount - 1) max: 0) printString , '.' ]); nl.
        out nextPutAll: '  f = last ifFalse: ['; nl.
        out nextPutAll: '    last := f.'; nl.
        out nextPutAll: '    p fill: 0 y: 0 width: 320 height: 180 color: 16.'; nl.
        out nextPutAll: '    rows := (fr at: f + 1) subStrings: ''/''.'; nl.
        out nextPutAll: '    0 to: rows size - 1 do: [ :ry |'; nl.
        out nextPutAll: '      row := rows at: ry + 1.'; nl.
        out nextPutAll: '      0 to: row size - 1 do: [ :rx |'; nl.
        out nextPutAll: '        c := (hex indexOf: (row at: rx + 1)) - 1.'; nl.
        out nextPutAll: '        c > 0 ifTrue: ['; nl.
        out nextPutAll: '          p fill: 80 + (rx * 2) y: 30 + (ry * 2) width: 2 height: 2 color: 16 + c.'; nl.
        out nextPutAll: '          p fill: 160 + (rx * 4) y: 30 + (ry * 4) width: 4 height: 4 color: 16 + c ] ] ].'; nl.
        out nextPutAll: '    s moveTo: 32 y: 30 frame: f ].'; nl.
        out nextPutAll: '  p present ].'; nl.
        out nextPutAll: 'p run.'; nl.
        ^out contents
    ]

    CocoaSpriteEditor class >> delFrameClicked [
        (Doc delFrame: CurFrame)
            ifFalse: [ ^self setStatus: 'the last frame stays' ].
        CurFrame := CurFrame min: Doc frameCount - 1.
        self syncFrameLabel.
        self repaintGrid.
    ]

    CocoaSpriteEditor class >> syncFrameLabel [
        FrameLabel isNil ifTrue: [ ^self ].
        FrameLabel onMain setStringValue:
            'Frame ' , (CurFrame + 1) printString , '/' , Doc frameCount printString.
    ]

    CocoaSpriteEditor class >> repaintAll [
        self repaintGrid.
        self repaintSwatches.
        self syncSliders.
        self syncFrameLabel.
    ]

    CocoaSpriteEditor class >> setStatus: aString [
        StatusLabel isNil ifTrue: [ ^self ].
        StatusLabel onMain setStringValue: aString.
    ]

    "── scripting hooks (rusttcl `gui`; the stage gates drive these) ─────"

    CocoaSpriteEditor class >> isOpen [
        Win isNil ifTrue: [ ^false ].
        ^Win sendBool: 'isVisible'
    ]
    CocoaSpriteEditor class >> doc [ ^Doc ]
    CocoaSpriteEditor class >> gridView [ ^GridView ]
    CocoaSpriteEditor class >> windowContentView [ ^Win onMain contentView ]
    CocoaSpriteEditor class >> swatchView [ ^SwatchView ]
    CocoaSpriteEditor class >> spedRows [ ^Doc rowsOf: CurFrame ]
    CocoaSpriteEditor class >> spedColor: i [ self selectColor: i ]
    CocoaSpriteEditor class >> spedTool: aSymbol [ self selectTool: aSymbol ]
    CocoaSpriteEditor class >> snapshotTo: aPath [
        ^CocoaUI snapshotWindow: Win to: aPath
    ]
    CocoaSpriteEditor class >> spedPaintX: x y: y [
        "The gate's paint: the SAME path a grid gesture takes, minus only the
         locationInView: read."
        self toolAtX: x y: y
    ]

    "── synthetic mouse (the self-service gate: a real NSEvent through the
       window's own sendEvent:, so hitTest -> recognizer -> action is the
       exact span exercised — no human hand needed) ──────────────────────"

    CocoaSpriteEditor class >> synthMouse: type atX: x y: y clicks: n [
        "Array with: caps below ten arguments — build the argument list
         positionally (the SpriteDoc palette lesson, second sighting)."
        | args ev |
        args := Array new: 10.
        args at: 1 put: type.
        args at: 2 put: x.               "location.x — the CGPoint's two doubles"
        args at: 3 put: y.               "location.y"
        args at: 4 put: 0.               "modifierFlags"
        args at: 5 put: 0.0.             "timestamp"
        args at: 6 put: (Win sendI64: 'windowNumber').
        args at: 7 put: nil.             "context (deprecated, nil)"
        args at: 8 put: 0.               "eventNumber"
        args at: 9 put: n.               "clickCount"
        args at: 10 put: 1.0.            "pressure (float)"
        "send:args:ret: is a REAL ObjcRef method — never through the onMain
         proxy (it would forward it as an ObjC selector). Doits run on the
         UI worker, which lives on the main thread, so direct is also safe."
        ev := (Cocoa classNamed: 'NSEvent')
            send: 'mouseEventWithType:location:modifierFlags:timestamp:windowNumber:context:eventNumber:clickCount:pressure:'
            args: args
            ret: #id.
        ev isNil ifTrue: [ ^self setStatus: 'synth: event mint failed' ].
        Win onMain sendEvent: ev.
    ]

    CocoaSpriteEditor class >> spedSynthClickAt: x y: y [
        "A full press: LeftMouseDown (1) then LeftMouseUp (2) at window
         coords (contentView coords coincide — its origin is the base
         origin)."
        self synthMouse: 1 atX: x y: y clicks: 1.
        self synthMouse: 2 atX: x y: y clicks: 1.
    ]

    "── teardown (UI-worker rebuild — CocoaUI teardown calls by name) ────"

    CocoaSpriteEditor class >> teardown [
        PreviewOn := nil. DirtyTicks := nil.
        PlaySwitch := nil. FpsSlider := nil. FpsLabel := nil.
        Win isNil ifFalse: [
            Win isValid ifTrue: [
                Win onMain setDelegate: nil.
                Win onMain orderOut: nil.
                Win release ] ].
        Win := nil. WinDelegate := nil. Delegates := nil. StatusLabel := nil.
        GridView := nil. SwatchView := nil. NameField := nil.
        WField := nil. HField := nil. RSlider := nil. GSlider := nil.
        BSlider := nil. RGBLabel := nil. FrameLabel := nil. ToolButtons := nil.
        Doc := nil. CurFrame := nil. SelColor := nil. Tool := nil.
    ]
]
